# Names only. Copy to .env and fill in the values locally; never commit real values.
# Web3Forms access key for the contact form (set the real value in Cloudflare).
PUBLIC_WEB3FORMS_ACCESS_KEY=
# Neon Postgres connection string (a secret). Locally for `npm run db:migrate`; in Cloudflare as a Worker secret.
DATABASE_URL=
# Google Search Console import (optional: without both, the nightly import is left out).
# The whole JSON key file of a service account (a secret). Set it as a Cloudflare Worker secret.
GOOGLE_SERVICE_ACCOUNT_JSON=
# The Search Console property: sc-domain:masajesrelaxmty.com, or a URL that ends in / (not a secret).
SEARCH_CONSOLE_SITE_URL=
