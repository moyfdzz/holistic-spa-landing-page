# Names only. Copy to .env and fill in the values locally; never commit real values.
# Web3Forms access key for the contact form (set the real value in Cloudflare).
PUBLIC_WEB3FORMS_ACCESS_KEY=
# Neon Postgres connection string (a secret). Locally for `npm run db:migrate`; in Cloudflare as a Worker secret.
DATABASE_URL=
# Clerk sign-in for /admin: without all three, /admin answers 503. On your computer use the keys of
# the development instance; the production keys are set only in Cloudflare.
# Publishable key (not a secret), written into the build: in Cloudflare it is a build variable, and
# changing it needs a new build. Locally in .env.
PUBLIC_CLERK_PUBLISHABLE_KEY=
# Secret key (a secret). Locally in .dev.vars; in Cloudflare as a Worker secret.
CLERK_SECRET_KEY=
# Emails allowed into /admin, separated by commas (personal data). Locally in .dev.vars; in
# Cloudflare as a Worker secret.
ADMIN_EMAILS=
# Google Search Console import (optional: without both, the nightly import is left out).
# The whole JSON key file of a service account (a secret). Set it as a Cloudflare Worker secret.
GOOGLE_SERVICE_ACCOUNT_JSON=
# The Search Console property: sc-domain:masajesrelaxmty.com, or a URL that ends in / (not a secret).
SEARCH_CONSOLE_SITE_URL=
