---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import About from "../components/About.astro";
import Services from "../components/Services.astro";
import Testimonials from "../components/Testimonials.astro";
import Faq from "../components/Faq.astro";
import CtaBand from "../components/CtaBand.astro";
import { site } from "../config/site.js";
import { services } from "../data/services.js";
import { buildLocalBusiness } from "../utils/seo.js";
import {
  getLangFromUrl,
  getLocalizedPath,
  useTranslations,
} from "../i18n/utils.js";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const description = t("meta.homeDescription");
const business = buildLocalBusiness({
  lang,
  site,
  description,
  services: services.map((service) => ({
    name: service.text[lang].name,
    description: service.text[lang].description,
  })),
});
---

<BaseLayout
  title={t("meta.homeTitle")}
  description={description}
  jsonLd={[business]}
>
  <Hero />
  <About />
  <Services />
  <Testimonials />
  <Faq />
  <CtaBand
    title={t("home.ctaTitle", { name: site.name })}
    ctaLabel={t("home.ctaButton")}
    ctaHref={getLocalizedPath("/contact", lang)}
  >
    {t("home.ctaText1")}
    <br />
    {t("home.ctaText2")}
  </CtaBand>
</BaseLayout>
