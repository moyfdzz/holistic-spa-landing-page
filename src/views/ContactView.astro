---
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import Card from "../components/Card.astro";
import ContactInfo from "../components/ContactInfo.astro";
import CtaBand from "../components/CtaBand.astro";
import Section from "../components/Section.astro";
import ContactForm from "../islands/ContactForm.jsx";
import contactImage from "../assets/images/ai/hero.webp";
import { site } from "../config/site.js";
import { services } from "../data/services.js";
import {
  getLangFromUrl,
  getLocalizedPath,
  useTranslations,
} from "../i18n/utils.js";
import { buildWhatsAppUrl } from "../utils/whatsapp.js";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

// The access key is public by design (Web3Forms), but it lives in an
// environment variable so it is not written in the code.
const web3formsKey = import.meta.env.PUBLIC_WEB3FORMS_ACCESS_KEY ?? "";
---

<BaseLayout
  title={`${t("meta.contactTitle")} | ${site.name}`}
  description={t("meta.contactDescription")}
>
  <Section class="contact" labelledby="contact-title">
    <div class="contact__headline" data-reveal>
      <h1 id="contact-title" class="section-title">
        {t("contact.title")}
      </h1>
      <p class="section-lead">{t("contact.lead")}</p>
    </div>

    <div class="contact__grid">
      <div data-reveal style="--reveal-delay: 150ms">
        <Card class="contact__card">
          <ContactForm
            client:load
            lang={lang}
            web3formsKey={web3formsKey}
            siteName={site.name}
            services={services.map((service) => ({
              slug: service.slug,
              name: service.text[lang].name,
              durations: service.durations,
            }))}
            whatsappUrl={buildWhatsAppUrl(site.whatsapp, t("whatsapp.message"))}
            privacyHref={getLocalizedPath("/aviso-de-privacidad", lang)}
          />
          <p class="contact__notice">{t("notice.professionalOnly")}</p>
        </Card>
      </div>

      <div class="contact__side" data-reveal style="--reveal-delay: 250ms">
        <ContactInfo />
        <div class="contact__media">
          <Image
            src={contactImage}
            alt={t("contact.imageAlt")}
            widths={[420, 640, 860]}
            sizes="(min-width: 60rem) 40vw, 92vw"
            class="contact__img"
          />
        </div>
      </div>
    </div>
  </Section>

  <CtaBand title={t("contact.ctaTitle")}>
    {t("contact.ctaText1")}
    <br />
    {t("contact.ctaText2")}
  </CtaBand>
</BaseLayout>

<style>
  .contact__headline {
    display: grid;
    gap: var(--space-3);
    max-width: 48rem;
    margin-bottom: var(--space-7);
  }

  .contact__grid {
    display: grid;
    gap: var(--space-6);
    align-items: start;
  }

  .contact__grid > div {
    display: grid;
  }

  .contact__card {
    padding: clamp(1.25rem, 0.5rem + 3vw, 2.5rem);
  }

  .contact__notice {
    margin-top: var(--space-4);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    text-align: center;
  }

  .contact__side {
    gap: var(--space-5);
  }

  .contact__media {
    display: none;
  }

  .contact__img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: var(--radius-xl);
    box-shadow: var(--shadow-lg);
  }

  @media (min-width: 60rem) {
    .contact__grid {
      grid-template-columns: 1.1fr 0.9fr;
      gap: var(--space-7);
    }

    .contact__media {
      display: grid;
    }
  }
</style>
