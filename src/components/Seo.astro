---
import { site } from "../config/site.js";
import { getLangFromUrl, getLocalizedPath } from "../i18n/utils.js";
import { absoluteUrl, trimTrailingSlash } from "../utils/seo.js";

interface Props {
  /** Title of the page, shown in the tab and in search results. */
  title: string;
  /** Short description of the page, shown in search results and when sharing. */
  description: string;
  /** Share image path (1200 x 630). */
  image?: string;
  /** Structured data (JSON-LD) objects to add to the page. */
  jsonLd?: Record<string, unknown>[];
}

const {
  title,
  description,
  image = "/og-image.jpg",
  jsonLd = [],
} = Astro.props;
const lang = getLangFromUrl(Astro.url);
const path = trimTrailingSlash(Astro.url.pathname);
const addressIn = (code: "es" | "en") =>
  absoluteUrl(getLocalizedPath(path, code), site.url);
const canonical = addressIn(lang);
const imageUrl = absoluteUrl(image, site.url);
---

<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
<link rel="alternate" hreflang="es" href={addressIn("es")} />
<link rel="alternate" hreflang="en" href={addressIn("en")} />
<link rel="alternate" hreflang="x-default" href={addressIn("es")} />

<meta property="og:type" content="website" />
<meta property="og:site_name" content={site.name} />
<meta property="og:locale" content={lang === "es" ? "es_MX" : "en_US"} />
<meta
  property="og:locale:alternate"
  content={lang === "es" ? "en_US" : "es_MX"}
/>
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={imageUrl} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageUrl} />

{jsonLd.map((data) => (
  <script
    is:inline
    type="application/ld+json"
    set:html={JSON.stringify(data)}
  />
))}
