---
import { Image } from "astro:assets";
import Button from "./Button.astro";
import Card from "./Card.astro";
import Section from "./Section.astro";
import { site } from "../config/site.js";
import { services } from "../data/services.js";
import { getYearsSince } from "../utils/date.js";
import {
  getLangFromUrl,
  getLocalizedPath,
  useTranslations,
} from "../i18n/utils.js";
import aboutImage from "../assets/images/ai/about.webp";

const yearsSince = getYearsSince(site.foundedYear);
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<Section id="about" tone="alt" labelledby="about-title">
  <div class="about">
    <div class="about__media" data-reveal>
      <Image
        src={aboutImage}
        alt={t("about.imageAlt")}
        widths={[420, 640, 860]}
        sizes="(min-width: 60rem) 36vw, 90vw"
        class="about__img"
      />
    </div>

    <div class="about__content">
      <h2 id="about-title" class="section-title" data-reveal>
        {t("about.title")}
      </h2>
      <p class="about__headline" data-reveal style="--reveal-delay: 100ms">
        {t("about.headline")}
      </p>
      <p class="section-lead" data-reveal style="--reveal-delay: 150ms">
        {t("about.lead")}
      </p>

      <div class="about__stats">
        <div data-reveal style="--reveal-delay: 200ms">
          <Card class="stat">
            <p class="stat__value">
              {t("about.since")} {site.foundedYear}
            </p>
            <h3 class="stat__label">
              {t("about.yearsPrefix")}
              <span data-years-since={site.foundedYear}>{yearsSince}</span>
              {t("about.yearsSuffix")}
            </h3>
            <p class="stat__text">{t("about.yearsText")}</p>
          </Card>
        </div>
        <div data-reveal style="--reveal-delay: 300ms">
          <Card class="stat">
            <p class="stat__value">{services.length}</p>
            <h3 class="stat__label">{t("about.servicesLabel")}</h3>
            <p class="stat__text">{t("about.servicesText")}</p>
          </Card>
        </div>
      </div>

      <div data-reveal style="--reveal-delay: 350ms">
        <Button href={getLocalizedPath("/contact", lang)} variant="secondary">
          {t("about.cta")}
        </Button>
      </div>
    </div>
  </div>
</Section>

<script>
  import { initYearsSince } from "../scripts/years-since.js";
  initYearsSince();
</script>

<style>
  .about {
    display: grid;
    gap: var(--space-7);
    align-items: center;
  }

  .about__media {
    position: relative;
    isolation: isolate;
    max-width: 30rem;
    margin-inline: auto;
  }

  .about__media::after {
    content: "";
    position: absolute;
    z-index: -1;
    inset: var(--space-4) calc(var(--space-4) * -1) calc(var(--space-4) * -1)
      var(--space-4);
    border: 2px solid var(--sage-300);
    border-radius: var(--radius-xl);
  }

  .about__img {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: var(--radius-xl);
    box-shadow: var(--shadow-lg);
  }

  .about__content {
    display: grid;
    gap: var(--space-5);
    justify-items: start;
  }

  .about__headline {
    font-family: var(--font-heading);
    font-size: var(--text-xl);
    font-weight: 600;
    line-height: 1.3;
    color: var(--sage-700);
  }

  .about__stats {
    display: grid;
    gap: var(--space-4);
    width: 100%;
  }

  .about__stats > div {
    display: grid;
  }

  .stat {
    display: grid;
    gap: var(--space-2);
  }

  .stat__value {
    font-family: var(--font-heading);
    font-size: var(--text-2xl);
    white-space: nowrap;
    font-weight: 600;
    line-height: 1;
    color: var(--sage-600);
  }

  .stat__label {
    font-size: var(--text-lg);
  }

  .stat__text {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  @media (min-width: 60rem) {
    .about {
      grid-template-columns: 0.85fr 1.15fr;
      gap: var(--space-8);
    }
  }

  @media (min-width: 40rem) {
    .about__stats {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
