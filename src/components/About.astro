---
import { Image } from "astro:assets";
import Button from "./Button.astro";
import Card from "./Card.astro";
import Section from "./Section.astro";
import aboutImage from "../assets/images/why-choose-us-image-2.png";
---

<Section id="about" tone="alt" labelledby="about-title">
  <div class="about">
    <div class="about__media" data-reveal>
      <Image
        src={aboutImage}
        alt="Velas, toallas enrolladas, piedras y plantas en un espacio de spa"
        widths={[420, 640, 860]}
        sizes="(min-width: 60rem) 36vw, 90vw"
        class="about__img"
      />
    </div>

    <div class="about__content">
      <h2 id="about-title" class="section-title" data-reveal>
        ¿Por qué elegirnos?
      </h2>
      <p class="about__headline" data-reveal style="--reveal-delay: 100ms">
        Llevamos bienestar, relajación y equilibrio a tu hogar.
      </p>
      <p class="section-lead" data-reveal style="--reveal-delay: 150ms">
        Nos enorgullece la satisfacción de nuestros clientes, quienes
        experimentan una transformación física y emocional a través de nuestros
        masajes.
      </p>

      <div class="about__stats">
        <div data-reveal style="--reveal-delay: 200ms">
          <Card class="stat">
            <p class="stat__value">8+</p>
            <h3 class="stat__label">Años de Experiencia</h3>
            <p class="stat__text">
              Con años de práctica en técnicas de masajes terapéuticos y
              bienestar, nos hemos especializado en ofrecer experiencias
              personalizadas que mejoran la calidad de vida de nuestros
              clientes.
            </p>
          </Card>
        </div>
        <div data-reveal style="--reveal-delay: 300ms">
          <Card class="stat">
            <p class="stat__value">10+</p>
            <h3 class="stat__label">Nuestros Servicios</h3>
            <p class="stat__text">
              Descubre nuestras terapias y encuentra el tratamiento perfecto
              para ti. Cada sesión está diseñada para adaptarse a tus
              necesidades, brindándote una experiencia única de relajación y
              sanación.
            </p>
          </Card>
        </div>
      </div>

      <div data-reveal style="--reveal-delay: 350ms">
        <Button href="/contact" variant="secondary">
          Obtener más información
        </Button>
      </div>
    </div>
  </div>
</Section>

<style>
  .about {
    display: grid;
    gap: var(--space-7);
    align-items: center;
  }

  .about__media {
    position: relative;
    isolation: isolate;
    max-width: 30rem;
    margin-inline: auto;
  }

  .about__media::after {
    content: "";
    position: absolute;
    z-index: -1;
    inset: var(--space-4) calc(var(--space-4) * -1) calc(var(--space-4) * -1)
      var(--space-4);
    border: 2px solid var(--sage-300);
    border-radius: var(--radius-xl);
  }

  .about__img {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: var(--radius-xl);
    box-shadow: var(--shadow-lg);
  }

  .about__content {
    display: grid;
    gap: var(--space-5);
    justify-items: start;
  }

  .about__headline {
    font-family: var(--font-heading);
    font-size: var(--text-xl);
    font-weight: 600;
    line-height: 1.3;
    color: var(--sage-700);
  }

  .about__stats {
    display: grid;
    gap: var(--space-4);
    width: 100%;
  }

  .about__stats > div {
    display: grid;
  }

  .stat {
    display: grid;
    gap: var(--space-2);
  }

  .stat__value {
    font-family: var(--font-heading);
    font-size: var(--text-3xl);
    font-weight: 600;
    line-height: 1;
    color: var(--sage-600);
  }

  .stat__label {
    font-size: var(--text-lg);
  }

  .stat__text {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  @media (min-width: 60rem) {
    .about {
      grid-template-columns: 0.85fr 1.15fr;
      gap: var(--space-8);
    }
  }

  @media (min-width: 40rem) {
    .about__stats {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
