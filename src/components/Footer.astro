---
import { Icon } from "astro-icon/components";
import { site } from "../config/site.js";
import {
  getLangFromUrl,
  getLocalizedPath,
  useTranslations,
} from "../i18n/utils.js";

const year = new Date().getFullYear();
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const socials = [
  {
    name: "Facebook",
    href: site.socials.facebook,
    icon: "simple-icons:facebook",
  },
  {
    name: "Instagram",
    href: site.socials.instagram,
    icon: "simple-icons:instagram",
  },
];
---

<footer class="footer">
  <div class="container">
    <div class="footer__grid">
      <div class="footer__brand">
        <a href={getLocalizedPath("/", lang)} class="footer__logo">
          <img src="/logo-mark.svg" alt="" width="32" height="32" />
          <span>{site.name}</span>
        </a>
        <p>{site.city}</p>
        <p>{site.region}</p>
        <p>{site.phone}</p>
      </div>

      <nav class="footer__col" aria-label={t("footer.company")}>
        <h2 class="footer__title">{t("footer.company")}</h2>
        <a href={getLocalizedPath("/", lang)}>{t("nav.home")}</a>
        <a href={getLocalizedPath("/#about", lang)}>{t("nav.about")}</a>
        <a href={getLocalizedPath("/#services", lang)}>{t("nav.services")}</a>
        <a href={getLocalizedPath("/contact", lang)}>{t("nav.contact")}</a>
      </nav>

      <nav class="footer__col" aria-label={t("footer.discover")}>
        <h2 class="footer__title">{t("footer.discover")}</h2>
        <a
          href="https://drbline.com/tipos-de-masaje-y-beneficios-para-la-salud/"
          target="_blank"
          rel="noopener noreferrer"
        >
          {t("footer.massageTypes")}
        </a>
        <a
          href="https://www.mayoclinic.org/es/tests-procedures/massage-therapy/about/pac-20384595"
          target="_blank"
          rel="noopener noreferrer"
        >
          {t("footer.massageBenefits")}
        </a>
        <a
          href="https://www.doctorbarret.com/que-es-una-limpieza-facial-profunda-y-cuales-son-sus-beneficios/"
          target="_blank"
          rel="noopener noreferrer"
        >
          {t("footer.facialBenefits")}
        </a>
      </nav>

      <nav class="footer__col" aria-label={t("footer.support")}>
        <h2 class="footer__title">{t("footer.support")}</h2>
        <a href={getLocalizedPath("/#FAQ", lang)}>{t("footer.faq")}</a>
        <a href={getLocalizedPath("/#services", lang)}>{t("nav.services")}</a>
        <a href={getLocalizedPath("/contact", lang)}>{t("nav.contact")}</a>
      </nav>

      <div class="footer__col">
        <h2 class="footer__title">{t("footer.social")}</h2>
        <div class="footer__socials">
          {socials.map((social) => (
            <a
              href={social.href}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={t("footer.socialLabel", {
                network: social.name,
                name: site.name,
              })}
            >
              <Icon name={social.icon} aria-hidden="true" />
            </a>
          ))}
        </div>
      </div>
    </div>

    <div class="footer__bottom">
      <p class="footer__notice">{t("notice.professionalOnly")}</p>
      <p>{t("footer.copyright", { year, name: site.name })}</p>
      <a href={getLocalizedPath("/aviso-de-privacidad", lang)}>
        {t("footer.privacy")}
      </a>
    </div>
  </div>
</footer>

<style>
  .footer {
    padding-block: var(--space-8) var(--space-5);
    background: var(--sage-900);
    color: var(--sage-100);
    font-size: var(--text-sm);
  }

  .footer a {
    color: inherit;
    text-decoration: none;
  }

  /* Easy to tap: every footer link is at least 44 px tall. */
  .footer__col a,
  .footer__bottom a,
  .footer__logo {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
  }

  .footer__socials a {
    justify-content: center;
    min-width: 2.75rem;
  }

  .footer a:hover {
    color: #fff;
    text-decoration: underline;
  }

  .footer :focus-visible {
    outline-color: var(--color-focus-on-dark);
  }

  .footer__grid {
    display: grid;
    gap: var(--space-6);
    grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr));
  }

  .footer__brand {
    display: grid;
    gap: var(--space-1);
    align-content: start;
  }

  .footer__logo {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    margin-bottom: var(--space-2);
    font-family: var(--font-heading);
    font-size: var(--text-lg);
    font-weight: 600;
    color: #fff;
  }

  .footer__logo img {
    flex: none;
    width: 2rem;
    height: 2rem;
    padding: 0.2rem;
    border-radius: var(--radius-md);
    background: var(--sage-100);
  }

  .footer__col {
    display: grid;
    gap: 0;
    align-content: start;
  }

  .footer__title {
    margin-bottom: var(--space-2);
    font-family: var(--font-body);
    font-size: var(--text-base);
    color: #fff;
  }

  .footer__socials {
    display: flex;
    gap: var(--space-3);
  }

  .footer__socials :global(svg) {
    width: 1.75rem;
    height: 1.75rem;
  }

  .footer__bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-2) var(--space-5);
    margin-top: var(--space-7);
    padding-top: var(--space-5);
    border-top: 1px solid rgba(255, 255, 255, 0.14);
    color: var(--sage-200);
  }

  /* On its own line above the copyright. */
  .footer__notice {
    flex-basis: 100%;
    color: #fff;
  }
</style>
