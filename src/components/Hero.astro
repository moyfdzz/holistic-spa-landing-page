---
import { getImage } from "astro:assets";
import { Icon } from "astro-icon/components";
import Badge from "./Badge.astro";
import Button from "./Button.astro";
import heroImage from "../assets/images/ai/hero.webp";
import heroMobileImage from "../assets/images/ai/hero-mobile.webp";
import {
  getLangFromUrl,
  getLocalizedPath,
  useTranslations,
} from "../i18n/utils.js";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

// Wide scene on tablets and desktops, vertical version on phones.
// A lower quality keeps the first image light so it does not slow down the fonts and text.
const desktop = await getImage({
  src: heroImage,
  widths: [640, 960, 1280],
  format: "webp",
  quality: 60,
});
const mobile = await getImage({
  src: heroMobileImage,
  widths: [320, 440, 560],
  format: "webp",
  quality: 50,
});
---

<section class="hero" id="home" aria-labelledby="hero-title">
  <div class="container hero__grid">
    <div class="hero__content">
      <div>
        <Badge>
          <Icon name="lucide:leaf" aria-hidden="true" />
          {t("hero.badge")}
        </Badge>
      </div>
      <h1
        id="hero-title"
        class="hero__title"

        style="--reveal-delay: 100ms"
      >
        {t("hero.title")}
      </h1>
      <p class="hero__lead">{t("hero.lead")}</p>
      <div class="hero__actions">
        <Button href={getLocalizedPath("/#services", lang)}>
          {t("hero.ctaServices")}
        </Button>
        <Button href={getLocalizedPath("/contact", lang)} variant="secondary">
          {t("hero.ctaMore")}
        </Button>
      </div>
    </div>

    <div class="hero__media">
      <div class="hero__shape" aria-hidden="true"></div>
      <div class="hero__float">
        <picture>
          <source
            media="(max-width: 59.99rem)"
            srcset={mobile.srcSet.attribute}
            sizes="92vw"
            type="image/webp"
          />
          <img
            src={desktop.src}
            srcset={desktop.srcSet.attribute}
            sizes="45vw"
            alt={t("hero.imageAlt")}
            width={desktop.attributes.width}
            height={desktop.attributes.height}
            loading="eager"
            fetchpriority="high"
            decoding="async"
            class="hero__img"
          />
        </picture>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: clip;
    padding-block: clamp(2rem, 1rem + 4vw, 5rem) var(--section-y);
    background:
      radial-gradient(60% 70% at 88% 8%, var(--sage-100), transparent 70%),
      var(--color-bg);
  }

  .hero__grid {
    display: grid;
    gap: var(--space-7);
    align-items: center;
  }

  .hero__content {
    display: grid;
    justify-items: start;
    gap: var(--space-5);
  }

  .hero__title {
    font-size: clamp(2.125rem, 1.4rem + 2.6vw, 3.25rem);
  }

  .hero__lead {
    max-width: 52ch;
    color: var(--color-text-muted);
    font-size: var(--text-lg);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-2);
  }

  .hero__media {
    position: relative;
    isolation: isolate;
  }

  .hero__shape {
    position: absolute;
    z-index: -1;
    top: -6%;
    right: -5%;
    width: 78%;
    aspect-ratio: 1;
    border-radius: 58% 42% 55% 45% / 48% 55% 45% 52%;
    background: linear-gradient(145deg, var(--sage-200), var(--sand-200));
  }

  .hero__float {
    animation: hero-float 9s ease-in-out infinite;
  }

  .hero__img {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: var(--radius-xl);
    box-shadow: var(--shadow-lg);
  }

  @keyframes hero-float {
    50% {
      transform: translateY(-0.6rem);
    }
  }

  @media (min-width: 60rem) {
    .hero__img {
      aspect-ratio: 5 / 4;
    }

    .hero__grid {
      grid-template-columns: 1.1fr 0.9fr;
      gap: var(--space-8);
    }
  }
</style>
