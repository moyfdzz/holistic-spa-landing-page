---
interface Props {
  /** Color of the pill. */
  tone?: "sage" | "sand";
}

const { tone = "sage" } = Astro.props;
---

<span class:list={["badge", `badge--${tone}`]}>
  <slot />
</span>

<style>
  .badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.4rem 1rem;
    border-radius: var(--radius-pill);
    font-size: var(--text-sm);
    font-weight: 600;
    line-height: 1.3;
  }

  .badge--sage {
    background: var(--sage-100);
    color: var(--sage-800);
  }

  .badge--sand {
    background: var(--sand-200);
    color: var(--clay-700);
  }
</style>
