---
import {
  getLangFromUrl,
  getLocalizedPath,
  languages,
  useTranslations,
} from "../i18n/utils.js";
import { publicPath } from "../utils/seo.js";

interface Props {
  /** Page the links lead to, in either language. The current page when not given. */
  path?: string;
}

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const { path = publicPath(Astro.url.pathname) } = Astro.props;
---

<div class="lang" role="group" aria-label={t("lang.label")}>
  {languages.map((code, index) => (
    <>
      {index > 0 && (
        <span class="lang__sep" aria-hidden="true">
          |
        </span>
      )}
      {/* The name comes from the content, so it starts with the visible
          code (WCAG 2.5.3). An aria-label would replace it. */}
      <a
        href={getLocalizedPath(path, code)}
        class="lang__link"
        lang={code}
        hreflang={code}
        aria-current={code === lang ? "true" : undefined}
        data-lang-link={code}
      >
        {code.toUpperCase()}
        <span class="visually-hidden">{t(`lang.${code}`)}</span>
      </a>
    </>
  ))}
</div>

{lang === "es" && (
  <div class="lang-suggest" data-lang-suggest hidden>
    <p lang="en">
      {t("lang.suggestText")}{" "}
      <a href={getLocalizedPath(path, "en")} hreflang="en" data-lang-link="en">
        {t("lang.suggestLink")}
      </a>
    </p>
    <button type="button" aria-label={t("lang.suggestClose")} data-lang-dismiss>
      &times;
    </button>
  </div>
)}

<script>
  import { initLanguage } from "../scripts/language.js";
  initLanguage();
</script>

<style>
  .lang {
    display: inline-flex;
    align-items: center;
    gap: 0;
    margin-left: auto;
    font-size: var(--text-sm);
    font-weight: 600;
  }

  .lang__sep {
    color: var(--sage-300);
  }

  .lang__link {
    display: inline-grid;
    place-items: center;
    min-width: 2.75rem;
    min-height: 2.75rem;
    padding: 0.35rem 0.4rem;
    border-radius: var(--radius-sm);
    color: var(--sage-700);
    text-decoration: none;
  }

  .lang__link:hover {
    background: var(--sage-50);
  }

  .lang__link[aria-current="true"] {
    background: var(--sage-100);
    color: var(--sage-800);
  }

  /* A small notice at the bottom, so it never covers the header or the page title. */
  .lang-suggest {
    position: fixed;
    z-index: 45;
    bottom: max(var(--space-4), env(safe-area-inset-bottom));
    left: max(var(--space-4), env(safe-area-inset-left));
    right: 5.5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    max-width: 28rem;
    padding: 0.6rem 0.9rem;
    border-radius: var(--radius-lg);
    background: var(--sage-800);
    box-shadow: var(--shadow-lg);
    color: #fff;
    font-size: var(--text-sm);
  }

  .lang-suggest[hidden] {
    display: none;
  }

  .lang-suggest a {
    color: inherit;
    font-weight: 700;
  }

  .lang-suggest button {
    flex: none;
    width: 2.75rem;
    height: 2.75rem;
    border: 0;
    background: none;
    color: inherit;
    font-size: 1.6rem;
    line-height: 1;
    cursor: pointer;
  }
</style>
