---
import { Icon } from "astro-icon/components";
import Section from "./Section.astro";
import { faq } from "../data/faq.js";
import { toSafeJson } from "../utils/seo.js";
import {
  getLangFromUrl,
  getLocalizedPath,
  useTranslations,
} from "../i18n/utils.js";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

// Structured data so search engines can show the questions.
const structuredData = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  inLanguage: lang,
  mainEntity: faq.map((item) => ({
    "@type": "Question",
    name: item.text[lang].question,
    acceptedAnswer: { "@type": "Answer", text: item.text[lang].answer },
  })),
};
---

<Section id="FAQ" tone="alt" labelledby="faq-title">
  <div class="faq">
    <div class="faq__intro" data-reveal>
      <h2 id="faq-title" class="section-title">
        {t("faq.title")}
      </h2>
      <p class="section-lead">{t("faq.lead")}</p>
      <a href={getLocalizedPath("/contact", lang)} class="faq__link">
        {t("faq.link")}
        <Icon name="lucide:arrow-right" aria-hidden="true" />
      </a>
    </div>

    <div class="accordion">
      {faq.map((item, index) => (
        <details
          class="accordion__item"
          id={`faq-${item.id}`}
          name="faq"
          data-reveal
          style={`--reveal-delay: ${index * 80}ms`}
        >
          <summary class="accordion__button">
            <h3 class="accordion__question">{item.text[lang].question}</h3>
            <Icon
              name="lucide:chevron-down"
              class="accordion__icon"
              aria-hidden="true"
            />
          </summary>
          <p class="answer__text">{item.text[lang].answer}</p>
        </details>
      ))}
    </div>
  </div>

  <script
    is:inline
    type="application/ld+json"
    set:html={toSafeJson(structuredData)}
  />
</Section>

<style>
  .faq {
    display: grid;
    gap: var(--space-7);
    align-items: start;
  }

  .faq__intro {
    display: grid;
    gap: var(--space-4);
    justify-items: start;
  }

  .faq__link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-weight: 700;
    color: var(--sage-700);
    text-decoration: none;
    border-bottom: 2px solid var(--sage-300);
    transition: border-color var(--duration-fast) var(--ease);
  }

  .faq__link :global(svg) {
    width: 1.1rem;
    height: 1.1rem;
  }

  .faq__link:hover {
    border-color: var(--sage-700);
  }

  .accordion {
    display: grid;
    gap: var(--space-3);
  }

  .accordion__item {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    box-shadow: var(--shadow-sm);
    transition: box-shadow var(--duration) var(--ease);
    interpolate-size: allow-keywords;
  }

  .accordion__item[open] {
    box-shadow: var(--shadow-md);
  }

  .accordion__button {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    min-height: 3.5rem;
    padding: var(--space-4) var(--space-5);
    border-radius: var(--radius-lg);
    color: var(--color-heading);
    cursor: pointer;
    list-style: none;
  }

  .accordion__button::-webkit-details-marker {
    display: none;
  }

  .accordion__question {
    font-family: var(--font-body);
    font-size: var(--text-base);
    font-weight: 700;
    line-height: 1.4;
  }

  .accordion__button :global(.accordion__icon) {
    width: 1.25rem;
    height: 1.25rem;
    flex-shrink: 0;
    color: var(--sage-600);
    transition: transform var(--duration) var(--ease);
  }

  .accordion__item[open] :global(.accordion__icon) {
    transform: rotate(180deg);
  }

  /* The answer slides open where the browser supports it; elsewhere it just appears. */
  .accordion__item::details-content {
    block-size: 0;
    overflow: hidden;
    transition:
      block-size var(--duration) var(--ease),
      content-visibility var(--duration) allow-discrete;
  }

  .accordion__item[open]::details-content {
    block-size: auto;
  }

  .answer__text {
    padding: 0 var(--space-5) var(--space-5);
    color: var(--color-text-muted);
  }

  @media (prefers-reduced-motion: reduce) {
    .accordion__item,
    .accordion__item::details-content,
    .accordion__button :global(.accordion__icon) {
      transition: none;
    }
  }

  @media (min-width: 60rem) {
    .faq {
      grid-template-columns: 0.8fr 1.2fr;
      gap: var(--space-8);
    }

    .faq__intro {
      position: sticky;
      top: calc(var(--header-h) + var(--space-6));
    }
  }
</style>
