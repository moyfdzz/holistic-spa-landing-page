---
import { Icon } from "astro-icon/components";
import Section from "./Section.astro";
import ServiceCard from "./ServiceCard.astro";
import { services } from "../data/services.js";
import { getLangFromUrl, useTranslations } from "../i18n/utils.js";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<Section id="services" labelledby="services-title">
  <div class="services__head" data-reveal>
    <h2 id="services-title" class="section-title">
      {t("services.title")}
    </h2>
    <p class="section-lead">{t("services.lead")}</p>
    <p class="services__hint">
      {t("services.hint")}
      <Icon name="lucide:arrow-right" aria-hidden="true" />
    </p>
  </div>

  <div
    class="services__scroller"
    role="region"
    aria-labelledby="services-title"
    data-reveal
    style="--reveal-delay: 150ms"
  >
    <ul class="services__grid">
      {services.map((service) => (
        <li class="services__item">
          <ServiceCard service={service} />
        </li>
      ))}
    </ul>
  </div>
</Section>

<style>
  .services__head {
    display: grid;
    gap: var(--space-3);
    justify-items: center;
    text-align: center;
    margin-bottom: var(--space-6);
  }

  .services__hint {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--sage-600);
    font-size: var(--text-sm);
    font-weight: 600;
  }

  .services__hint :global(svg) {
    width: 1.1rem;
    height: 1.1rem;
  }

  /* Phones: a row of cards that snaps as you swipe. */
  .services__scroller {
    position: relative;
    margin-inline: calc(var(--space-4) * -1);
    padding-inline: var(--space-4);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: var(--space-4);
    overscroll-behavior-x: contain;
  }

  .services__grid {
    display: flex;
    gap: var(--space-4);
    margin: 0;
    padding: var(--space-2) 0 var(--space-4);
    list-style: none;
  }

  .services__item {
    flex: 0 0 min(82%, 20rem);
    scroll-snap-align: start;
  }

  /* Tablets and desktops: a grid, no scrolling and no hint. */
  @media (min-width: 48rem) {
    .services__hint {
      display: none;
    }

    .services__scroller {
      margin-inline: 0;
      padding-inline: 0;
      overflow: visible;
    }

    /* Wrapping rows with centered cards: an incomplete last row stays balanced. */
    .services__grid {
      --per-row: 2;
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: var(--space-5);
    }

    .services__item {
      flex: 0 0
        calc((100% - (var(--per-row) - 1) * var(--space-5)) / var(--per-row));
    }
  }

  @media (min-width: 64rem) {
    .services__grid {
      --per-row: 3;
    }
  }

  @media (min-width: 75rem) {
    .services__grid {
      --per-row: 4;
    }
  }
</style>
