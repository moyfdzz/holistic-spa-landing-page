---
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";
import "swiper/css/bundle";
import Section from "./Section.astro";
import { services } from "../data/services.js";
import { getLangFromUrl, useTranslations } from "../i18n/utils.js";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<Section id="services" labelledby="services-title">
  <div class="services__head" data-reveal>
    <h2 id="services-title" class="section-title">
      {t("services.title")}
    </h2>
    <p class="section-lead">{t("services.lead")}</p>
  </div>

  <div class="services__carousel" data-reveal style="--reveal-delay: 150ms">
    <div class="services__nav">
      <button
        type="button"
        class="services__arrow swiper__custom-nav--prev"
        aria-label={t("services.prev")}
      >
        <Icon name="lucide:arrow-left" aria-hidden="true" />
      </button>
      <button
        type="button"
        class="services__arrow swiper__custom-nav--next"
        aria-label={t("services.next")}
      >
        <Icon name="lucide:arrow-right" aria-hidden="true" />
      </button>
    </div>

    <div class="swiper">
      <div class="swiper-wrapper">
        {services.map((service) => (
          <div class="swiper-slide">
            <article class="service-card">
              <Image
                src={service.image}
                alt=""
                widths={[480, 720, 960]}
                sizes="(min-width: 60rem) 30vw, (min-width: 48rem) 60vw, 90vw"
                class="service-card__img"
              />
              <h3 class="service-card__name">
                {t(`services.items.${service.id}`)}
              </h3>
            </article>
          </div>
        ))}
      </div>
    </div>
  </div>
</Section>

<script>
  import "../scripts/services-swiper.js";
</script>

<style>
  .services__head {
    display: grid;
    gap: var(--space-3);
    justify-items: center;
    text-align: center;
    margin-bottom: var(--space-6);
  }

  .services__nav {
    display: flex;
    justify-content: flex-end;
    gap: var(--space-3);
    margin-bottom: var(--space-4);
  }

  .services__arrow {
    display: inline-grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border: 1.5px solid var(--sage-600);
    border-radius: var(--radius-pill);
    background: transparent;
    color: var(--sage-800);
    cursor: pointer;
    transition:
      background-color var(--duration-fast) var(--ease),
      color var(--duration-fast) var(--ease);
  }

  .services__arrow :global(svg) {
    width: 1.25rem;
    height: 1.25rem;
  }

  .services__arrow:hover {
    background: var(--sage-700);
    color: #fff;
  }

  /* Room for the card shadows, which the carousel would otherwise clip. */
  .swiper {
    margin-block: calc(var(--space-4) * -1);
    padding-block: var(--space-4);
  }

  .swiper-slide {
    height: auto;
    transition:
      transform var(--duration) var(--ease),
      opacity var(--duration) var(--ease);
  }

  @media (min-width: 48rem) {
    .swiper-slide:not(.swiper-slide-active) {
      opacity: 0.78;
      transform: scale(0.95);
    }
  }

  .service-card {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    aspect-ratio: 4 / 3;
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-md);
    background: var(--sage-100);
  }

  .service-card__img {
    position: absolute;
    inset: 0;
    z-index: -2;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.9s var(--ease);
  }

  .service-card:hover .service-card__img {
    transform: scale(1.05);
  }

  .service-card::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(
      to top,
      rgba(28, 38, 28, 0.78),
      rgba(28, 38, 28, 0) 55%
    );
  }

  .service-card__name {
    position: absolute;
    inset: auto var(--space-5) var(--space-4);
    font-family: var(--font-body);
    font-size: var(--text-lg);
    font-weight: 600;
    color: #fff;
    text-wrap: balance;
  }
</style>
