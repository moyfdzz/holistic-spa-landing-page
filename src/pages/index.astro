---
import BaseLayout from "../layouts/BaseLayout.astro";
import "../styles/index.css";
// Must come after the page CSS so Swiper's rules win the cascade, as in the original.
import "swiper/css/bundle";
---

<BaseLayout>
  <!-- Navbar -->
  <header class="header">
    <div class="header__container">
      <a href="/" class="logo">
        Masajes Holísticos Rossy
      </a>
      <nav class="nav">
        <ul class="nav__links">
          <li>
            <a href="/" class="nav__link nav__link--active" id="home-link">
              Inicio
            </a>
          </li>
          <li>
            <a href="/#about" class="nav__link" id="about-link">
              Nosotros
            </a>
          </li>
          <li>
            <a href="/#services" class="nav__link" id="services-link">
              Servicios
            </a>
          </li>
          <li>
            <a href="/#FAQ" class="nav__link" id="faq-link">
              Preguntas
            </a>
          </li>
          <li>
            <a href="/contact" class="nav__link" id="contact-link">
              Contacto
            </a>
          </li>
          <div class="button header__button--close-menu">
            <i class="fas fa-times close-menu"></i>
          </div>
        </ul>
      </nav>
      <button
        type="button"
        class="button header__button"
        onclick="window.location.href='/contact'"
      >
        Contáctanos
      </button>
      <div class="button header__button--show-menu">
        <i class="fas fa-bars show-menu"></i>
      </div>
    </div>
  </header>
  <!-- Navbar End -->

  <main>
    <!-- Hero Section -->
    <section class="hero" id="home">
      <div class="hero__container">
        <div class="hero__content">
          <h6 class="hero__slogan">
            Renueva tu cuerpo, relaja tu mente y equilibra tu espíritu
          </h6>

          <h1 class="hero__title">
            Experimenta el Bienestar con Masajes Terapéuticos y Holísticos
          </h1>

          <p class="hero__description">
            Disfruta de un espacio de paz y armonía, donde cada masaje está
            diseñado para aliviar el estrés, reducir tensiones y revitalizar tu
            energía. Descubre el equilibrio perfecto entre cuerpo y mente.
          </p>

          <div class="hero__button">
            <button
              type="button"
              class="button hero__button--primary"
              onclick="window.location.href='/#services'"
            >
              Ver servicios
            </button>
            <button
              type="button"
              class="button hero__button--secondary"
              onclick="window.location.href='/contact'"
            >
              Más información
            </button>
          </div>
        </div>
      </div>
    </section>

    <!-- Section Divider -->
    <div class="divider"></div>

    <!-- About Section -->
    <section class="about" id="about">
      <h1 class="about__title">¿Por qué elegirnos?</h1>
      <div class="about__container">
        <div class="about__imgs">
          <img
            src="/assets/images/why-choose-us-image-2.png"
            alt="Imagen de elementos relacionados a un spa"
            class="about__img"
          />
        </div>

        <div class="about__content">
          <h2>Llevamos bienestar, relajación y equilibrio a tu hogar.</h2>
          <p>
            Nos enorgullece la satisfacción de nuestros clientes, quienes
            experimentan una transformación física y emocional a través de
            nuestros masajes.
          </p>

          <!-- Years of Experience -->
          <div class="about__years-of-experience">
            <div>
              <h4>
                <b>Años de Experiencia</b>
              </h4>
              <hr />
            </div>
            <h5>8+</h5>
            <p>
              Con años de práctica en técnicas de masajes terapéuticos y
              bienestar, nos hemos especializado en ofrecer experiencias
              personalizadas que mejoran la calidad de vida de nuestros
              clientes.
            </p>
          </div>

          <!-- Services Diversity -->
          <div class="about__services-diversity">
            <div>
              <h4>
                <b>Nuestros Servicios</b>
              </h4>
              <hr />
            </div>
            <h5>10+</h5>
            <p>
              Descubre nuestras terapias y encuentra el tratamiento perfecto
              para ti. Cada sesión está diseñada para adaptarse a tus
              necesidades, brindándote una experiencia única de relajación y
              sanación.
            </p>
          </div>

          <button
            type="button"
            class="button about__button btn--transparent"
            onclick="window.location.href='/contact'"
          >
            Obtener más información
          </button>
        </div>
      </div>
    </section>

    <!-- Section Divider -->
    <div class="divider"></div>

    <!-- Services Section -->
    <section class="services" id="services">
      <div class="services__container">
        <h1 class="services__title">Nuestros Servicios</h1>
        <p class="services__description">
          A continuación están los diferentes servicios con los que contamos
          para satisfacer tus necesidades.
        </p>

        <!-- Swiper -->
        <div class="swiper">
          <!-- Navigations Buttons -->
          <div class="swiper__custom-nav">
            <div class="swiper__custom-nav--prev">
              <i class="fa-solid fa-arrow-left"></i>
            </div>
            <div class="swiper__custom-nav--next">
              <i class="fa-solid fa-arrow-right"></i>
            </div>
          </div>
          <!-- Slides -->
          <div class="swiper-wrapper">
            <!-- Service 1 -->
            <div class="swiper-slide">
              <div class="service__content">
                <div class="service__info">
                  <h6 class="service__name">Masaje relajante</h6>
                </div>
              </div>
              <img
                src="/assets/images/relaxing-massage.jpg"
                alt="Imagen de masaje relajante"
                class="service__img"
              />
            </div>

            <!-- Service 2 -->
            <div class="swiper-slide">
              <div class="service__content">
                <div class="service__info">
                  <h6 class="service__name">Masaje descontracturante</h6>
                </div>
              </div>
              <img
                src="/assets/images/decontracting-massage.jpg"
                alt="Imagen de masaje descontracturante"
                class="service__img"
              />
            </div>

            <!-- Service 3 -->
            <div class="swiper-slide">
              <div class="service__content">
                <div class="service__info">
                  <h6 class="service__name">Masaje linfático</h6>
                </div>
              </div>
              <img
                src="/assets/images/linfatic-massage.jpg"
                alt="Imagen de masaje descontracturante"
                class="service__img"
              />
            </div>

            <!-- Service 4 -->
            <div class="swiper-slide">
              <div class="service__content">
                <div class="service__info">
                  <h6 class="service__name">Masaje Shiatsu</h6>
                </div>
              </div>
              <img
                src="/assets/images/shiatsu-massage.jpg"
                alt="Imagen de masaje descontracturante"
                class="service__img"
              />
            </div>

            <!-- Service 5 -->
            <div class="swiper-slide">
              <div class="service__content">
                <div class="service__info">
                  <h6 class="service__name">Masaje deportivo</h6>
                </div>
              </div>
              <img
                src="/assets/images/sport-massage.jpg"
                alt="Imagen de masaje descontracturante"
                class="service__img"
              />
            </div>

            <!-- Service 6 -->
            <div class="swiper-slide">
              <div class="service__content">
                <div class="service__info">
                  <h6 class="service__name">Facial de limpieza profunda</h6>
                </div>
              </div>
              <img
                src="/assets/images/deep-facial.jpg"
                alt="Imagen de masaje descontracturante"
                class="service__img"
              />
            </div>

            <!-- Service 7 -->
            <div class="swiper-slide">
              <div class="service__content">
                <div class="service__info">
                  <h6 class="service__name">Facial hidratante</h6>
                </div>
              </div>
              <img
                src="/assets/images/moisturizing-facial.jpg"
                alt="Imagen de masaje descontracturante"
                class="service__img"
              />
            </div>

            <!-- Service 8 -->
            <div class="swiper-slide">
              <div class="service__content">
                <div class="service__info">
                  <h6 class="service__name">Masaje prenatal</h6>
                </div>
              </div>
              <img
                src="/assets/images/prenatal-massage.jpg"
                alt="Imagen de masaje descontracturante"
                class="service__img"
              />
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Section Divider -->
    <div class="divider"></div>

    <!-- FAQ Section -->
    <section class="FAQ" id="FAQ">
      <div class="FAQ__container">
        <div class="FAQ__header">
          <h1 class="FAQ__title">PREGUNTAS FRECUENTES</h1>
          <a href="/contact" class="FAQ__button">
            SOLICITA MAS INFORMACION
            <i class="fa-solid fa-arrow-right"></i>
          </a>
        </div>

        <div class="accordion">
          <div class="accordion__item" id="question1">
            <a
              href="javascript:void(0)"
              class="accordion__link"
              data-accordion-toggle="question1"
            >
              <h3 class="accordion__title">
                ¿Qué tipos de masajes ofrecen en la comodidad de mi hogar?
              </h3>
              <i class="fa-solid fa-arrow-up" id="accordion-arrow"></i>
            </a>
            <div class="answer">
              <p class="answer__text">
                Ofrecemos una variedad de masajes, incluyendo masaje relajante,
                terapéutico, deportivo y para aliviar el estrés, todos
                realizados en la comodidad de tu hogar según tus necesidades.
              </p>
            </div>
            <hr />
          </div>

          <div class="accordion__item" id="question2">
            <a
              href="javascript:void(0)"
              class="accordion__link"
              data-accordion-toggle="question2"
            >
              <h3 class="accordion__title">
                ¿Cómo puedo reservar una cita para un masaje a domicilio?
              </h3>
              <i class="fa-solid fa-arrow-up" id="accordion-arrow"></i>
            </a>
            <div class="answer">
              <p class="answer__text">
                Puedes reservar tu cita fácilmente llamándonos, enviándonos un
                mensaje a través de nuestra página web o por WhatsApp, o por
                cualquiera de nuestras redes sociales en la parte de abajo.
                Estamos disponibles para programar tu masaje según tu horario
                preferido.
              </p>
            </div>
            <hr />
          </div>

          <div class="accordion__item" id="question3">
            <a
              href="javascript:void(0)"
              class="accordion__link"
              data-accordion-toggle="question3"
            >
              <h3 class="accordion__title">
                ¿Necesito tener alguna preparación especial antes de recibir el
                masaje en casa?
              </h3>
              <i class="fa-solid fa-arrow-up" id="accordion-arrow"></i>
            </a>
            <div class="answer">
              <p class="answer__text">
                No necesitas prepararte de manera especial, pero te recomendamos
                estar en un ambiente cómodo y relajado. Nosotros llevaremos todo
                lo necesario para el masaje, solo asegúrate de contar con un
                espacio tranquilo.
              </p>
            </div>
            <hr />
          </div>

          <div class="accordion__item" id="question4">
            <a
              href="javascript:void(0)"
              class="accordion__link"
              data-accordion-toggle="question4"
            >
              <h3 class="accordion__title">
                ¿Qué tan lejos viajan para brindar el servicio a domicilio?
              </h3>
              <i class="fa-solid fa-arrow-up" id="accordion-arrow"></i>
            </a>
            <div class="answer">
              <p class="answer__text">
                Ofrecemos nuestros servicios en toda el área metropolitana de
                Monterrey. Si no estás seguro de si cubrimos tu área,
                contáctanos y te confirmaremos con gusto.
              </p>
            </div>
            <hr />
          </div>

          <div class="accordion__item" id="question5">
            <a
              href="javascript:void(0)"
              class="accordion__link"
              data-accordion-toggle="question5"
            >
              <h3 class="accordion__title">
                ¿Es seguro recibir un masaje en casa?
              </h3>
              <i class="fa-solid fa-arrow-up" id="accordion-arrow"></i>
            </a>
            <div class="answer">
              <p class="answer__text">
                Sí, contamos con capacitación y se siguen estrictas normas de
                higiene y profesionalismo. Nos aseguramos de que cada servicio
                sea seguro, relajante y beneficioso para tu bienestar.
              </p>
            </div>
            <hr />
          </div>
        </div>
      </div>
    </section>
  </main>

  <!-- Contact Callout -->
  <section class="callout">
    <div class="callout__container">
      <h4 class="callout__title">
        Conéctate con Masajes Holísticos Rossy para tu Viaje de Bienestar
      </h4>
      <p class="callout__description">
        Rejuvenece tu cuerpo y mente con nuestras terapias de masaje.
        <br />
        Contáctanos hoy para tratamientos personalizados y una experiencia de
        relajación única.
      </p>
      <button
        type="button"
        class="button callout__button"
        onclick="window.location.href='/contact'"
      >
        Contáctanos
      </button>
    </div>
  </section>

  <!-- Footer -->
  <footer class="footer">
    <div class="footer__container">
      <div class="footer__contacts">
        <a href="/">
          <h4>Masajes Holísticos Rossy</h4>
        </a>
        <div>
          <p>Monterrey</p>
          <p>Nuevo León, México</p>
          <p>+52 81 8017 1904</p>
        </div>
      </div>

      <div class="footer__links">
        <h4>Compañía</h4>
        <div class="footer__link">
          <a href="/">Inicio</a>
          <a href="/#about">Nosotros</a>
          <a href="/#services">Servicios</a>
          <a href="/contact">Contacto</a>
        </div>
      </div>

      <div class="footer__links">
        <h4>Descubre el Bienestar</h4>
        <div class="footer__link">
          <a
            href="https://drbline.com/tipos-de-masaje-y-beneficios-para-la-salud/"
            target="_blank"
          >
            Tipos de masajes
          </a>
          <a
            href="https://www.mayoclinic.org/es/tests-procedures/massage-therapy/about/pac-20384595"
            target="_blank"
          >
            Beneficios de los masajes
          </a>
          <a
            href="https://www.doctorbarret.com/que-es-una-limpieza-facial-profunda-y-cuales-son-sus-beneficios/"
            target="_blank"
          >
            Limpieza facial y sus beneficios
          </a>
        </div>
      </div>

      <div class="footer__links">
        <h4>Soporte</h4>
        <div class="footer__link">
          <a href="/#FAQ">Preguntas Frecuentes</a>
          <a href="/#services">Servicios</a>
          <a href="/contact">Contacto</a>
        </div>
      </div>
      <div class="socials__section">
        <h4>Redes sociales</h4>
        <div class="socials">
          <a
            href="https://www.facebook.com/profile.php?id=61572853523014"
            target="_blank"
          >
            <i class="fa-brands fa-square-facebook"></i>
          </a>
          <a href="https://www.instagram.com/masajes_rossy/" target="_blank">
            <i class="fa-brands fa-square-instagram"></i>
          </a>
        </div>
      </div>
    </div>
    <div class="copyright">
      <div>
        Icons made by
        <a href="https://www.flaticon.com/authors/mikan933" title="mikan933">
          mikan933
        </a>
        from
        <a href="https://www.flaticon.com/" title="Flaticon">
          www.flaticon.com'
        </a>
      </div>
      <p>
        <span>&copy; 2025 Masajes Holísticos Rossy.</span>
      </p>
    </div>
  </footer>
</BaseLayout>
