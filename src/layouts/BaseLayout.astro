---
import "@fontsource/lora/latin-400.css";
import "@fontsource/lora/latin-600.css";
import "@fontsource/quicksand/latin-400.css";
import "@fontsource/quicksand/latin-500.css";
import "@fontsource/quicksand/latin-600.css";
import "../styles/tokens.css";
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { site } from "../config/site.js";
import { getLangFromUrl, getLocalizedPath } from "../i18n/utils.js";

interface Props {
  /** Page title shown in the browser tab. */
  title?: string;
}

const { title = site.name } = Astro.props;
const lang = getLangFromUrl(Astro.url);
// Full address of this page in another language, for hreflang links.
const alternate = (code: "es" | "en") =>
  new URL(
    getLocalizedPath(Astro.url.pathname.replace(/(.)\/$/, "$1"), code),
    site.url,
  ).href;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#475d42" />
    <meta name="application-name" content={site.shortName} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content={lang === "es" ? "es_MX" : "en_US"} />
    <link rel="alternate" hreflang="es" href={alternate("es")} />
    <link rel="alternate" hreflang="en" href={alternate("en")} />
    <link rel="alternate" hreflang="x-default" href={alternate("es")} />

    <!-- Lets the CSS hide "reveal on scroll" content only when scripts run -->
    <script is:inline>
      document.documentElement.classList.add("js");
    </script>
    <title>{title}</title>
  </head>
  <body>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />

    <script>
      import { initReveal } from "../utils/reveal.js";
      initReveal();
    </script>
  </body>
</html>
