---
import "@fontsource/lora/latin-400.css";
import "@fontsource/lora/latin-600.css";
import "@fontsource/quicksand/latin-400.css";
import "@fontsource/quicksand/latin-500.css";
import "@fontsource/quicksand/latin-600.css";
// The fonts used above the fold are loaded early, so the text does not jump when they arrive.
import lora600 from "@fontsource/lora/files/lora-latin-600-normal.woff2?url";
import quicksand400 from "@fontsource/quicksand/files/quicksand-latin-400-normal.woff2?url";
import quicksand600 from "@fontsource/quicksand/files/quicksand-latin-600-normal.woff2?url";
import "../styles/tokens.css";
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Seo from "../components/Seo.astro";
import WhatsAppButton from "../components/WhatsAppButton.astro";
import { site } from "../config/site.js";
import { getLangFromUrl } from "../i18n/utils.js";

interface Props {
  /** Page title shown in the browser tab and in search results. */
  title?: string;
  /** Short description for search results and sharing. */
  description: string;
  /** Structured data (JSON-LD) objects for the page. */
  jsonLd?: Record<string, unknown>[];
}

const { title = site.name, description, jsonLd } = Astro.props;
const lang = getLangFromUrl(Astro.url);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    {[lora600, quicksand400, quicksand600].map((href) => (
      <link rel="preload" href={href} as="font" type="font/woff2" crossorigin />
    ))}
    {site.googleSiteVerification && (
      <meta
        name="google-site-verification"
        content={site.googleSiteVerification}
      />
    )}
    <meta name="theme-color" content="#475d42" />
    <meta name="application-name" content={site.shortName} />
    <Seo title={title} description={description} jsonLd={jsonLd} />

    <!-- Lets the CSS hide "reveal on scroll" content only when scripts run -->
    <script is:inline>
      document.documentElement.classList.add("js");
    </script>
  </head>
  <body>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <WhatsAppButton />

    <script>
      import { initReveal } from "../utils/reveal.js";
      initReveal();
    </script>
  </body>
</html>
